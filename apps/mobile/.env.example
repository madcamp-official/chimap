# Android/iOS 로컬 build에서는 이 파일을 apps/mobile/.env로 복사합니다.
# 명령마다 이 파일을 명시적으로 로드하고, .env가 Git에서 제외되는지 확인합니다.
# client binary에 포함돼도 되는 공개 식별자만 입력합니다. DATABASE_URL,
# AUTH_SESSION_SECRET, NAVER_MAP_NCP_KEY, Kakao REST secret, Apple private key
# 같은 서버 비밀값은 절대 넣지 않습니다.

# development: org.madcamp.chimap.dev
# staging:     org.madcamp.chimap.staging
# production:  org.madcamp.chimap
APP_ENV=staging

# 실제 휴대폰의 localhost는 Mac이 아닙니다. staging URL 또는 휴대폰에서
# 접근 가능한 Mac의 LAN 주소를 사용합니다.
EXPO_PUBLIC_API_BASE_URL=https://staging.chimap.madcamp-kaist.org

# NAVER Cloud Platform Console > Services > Application Services > Maps.
# Dynamic Map을 활성화하고 대응하는 iOS Bundle ID / Android package를 등록합니다.
# 현재 공용 Expo config는 iOS 빌드에서도 두 값을 모두 검증합니다.
NAVER_MAP_CLIENT_ID_IOS=
NAVER_MAP_CLIENT_ID_ANDROID=

# Kakao Developers > App > Platform key > Native app key.
# iOS key에는 Bundle ID, Android key에는 package/key hash를 등록합니다.
KAKAO_NATIVE_IOS_APP_KEY=
KAKAO_NATIVE_ANDROID_APP_KEY=
