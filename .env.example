# CHIMap의 유일한 환경변수 템플릿입니다.
# 로컬에서는 이 파일을 .env로 복사하고 실제 비밀값을 입력합니다.
# 비밀값은 커밋하지 않으며 VITE_NAVER_MAP_NCP_KEY_ID만 브라우저에 공개됩니다.

NODE_ENV=development

# PostgreSQL 18 + PostGIS
DATABASE_URL=postgresql://chimap:change-me@postgres:5432/chimap
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_SSL_MODE=disable

POSTGRES_DB=chimap
POSTGRES_USER=chimap
POSTGRES_PASSWORD=

# Kakao Local 및 경로 API (서버 전용)
KAKAO_REST_API_KEY=

# 같은 NAVER Maps Application을 쓰면 두 Key ID에는 같은 공개 Client ID를
# 입력합니다. NAVER_MAP_NCP_KEY만 서버 전용 Client Secret입니다.
NAVER_MAP_NCP_KEY_ID=
NAVER_MAP_NCP_KEY=
VITE_NAVER_MAP_NCP_KEY_ID=

# 공공데이터포털 TAGO (서버 전용)
DATA_GO_KR_SERVICE_KEY=
TAGO_BUS_STOP_SERVICE_KEY=
TAGO_BUS_ROUTE_SERVICE_KEY=
TAGO_BUS_ARRIVAL_SERVICE_KEY=
TAGO_BUS_LOCATION_SERVICE_KEY=

TAGO_BASE_URL=https://apis.data.go.kr/1613000
TAGO_RESPONSE_TYPE=json
TAGO_DEFAULT_CITY_CODE=25
BUS_STOPS_DATA_PATH=/data/bus-stops.csv
TAGO_HTTP_TIMEOUT_MS=7000
TAGO_HTTP_RETRY_COUNT=2
TAGO_NEARBY_STOP_CACHE_TTL_SECONDS=300
TAGO_ROUTE_CACHE_TTL_SECONDS=86400
TAGO_ROUTE_STOPS_CACHE_TTL_SECONDS=86400
TAGO_ARRIVAL_CACHE_TTL_SECONDS=20
TAGO_LOCATION_CACHE_TTL_SECONDS=10

# 공개 주변 정류장 API 상한 / 추천 내부 점진 탐색 상한
TRANSIT_MAX_NEARBY_STOP_DISTANCE_METERS=500
TRANSIT_ROUTE_SEARCH_MAX_DISTANCE_METERS=1200
TRANSIT_MAX_TRANSFER_COUNT=1
TRANSIT_WALK_SPEED_KMH=4.5
TRANSIT_BUS_AVERAGE_SPEED_KMH=20
TRANSIT_STOP_DWELL_SECONDS=25

PORT=8080
WEB_ORIGIN=http://localhost:5173
WEB_DIST_PATH=
LOG_LEVEL=info
LIVE_API_TEST=0

# 내부 Prometheus endpoint. Compose에서는 api:9091/metrics로만 접근합니다.
METRICS_ENABLED=0
METRICS_PORT=9091
APP_COMMIT_SHA=
BACKUP_STATUS_PATH=
BACKUP_DIR=/var/backups/chimap
TRANSIT_SYNC_STATUS_PATH=
TRANSIT_SYNC_STATUS_DIR=/var/backups/chimap/transit-sync
TRANSIT_SYNC_AREAS_FILE=/root/chimap/ops/transit-sync-areas.json

# 운영자 장애 알림. URL은 서버의 실제 .env에만 입력합니다.
# slack: Slack Incoming Webhook, discord: Discord Webhook,
# generic: 정규화한 경보 JSON을 받을 HTTPS endpoint
ALERT_NOTIFICATION_PROVIDER=slack
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=5000
ALERT_RELAY_PORT=9080
ALERT_STATUS_URL=https://chimap.madcamp-kaist.org/api/v1/health

# 비워 두면 개발은 http://localhost:8080, 운영은 same-origin /api를 사용합니다.
VITE_API_BASE_URL=
