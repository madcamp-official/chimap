{
  "name": "@chimap/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android",
    "dev": "expo start --dev-client",
    "eas-build-post-install": "pnpm --filter @chimap/contracts build && pnpm --filter @chimap/app-core build && pnpm --filter @chimap/design-tokens build",
    "format:check": "tsc --noEmit --pretty false",
    "ios": "expo run:ios",
    "native:prebuild": "expo prebuild --clean",
    "start": "expo start --dev-client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@chimap/app-core": "workspace:*",
    "@chimap/contracts": "workspace:*",
    "@chimap/design-tokens": "workspace:*",
    "@kingstinct/react-native-healthkit": "14.0.2",
    "@mj-studio/react-native-naver-map": "2.9.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-seoul/kakao-login": "5.4.2",
    "@tanstack/query-async-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "expo": "~56.0.17",
    "expo-apple-authentication": "~56.0.4",
    "expo-build-properties": "~56.0.24",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.16",
    "expo-location": "~56.0.22",
    "expo-router": "~56.2.16",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-health-connect": "3.5.3",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.8.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.85.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
