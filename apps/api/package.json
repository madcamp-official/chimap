{
  "name": "@chimap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "format:check": "tsc -p tsconfig.json --noEmit",
    "tago:health": "tsx src/cli/transit.ts health",
    "tago:test-nearby": "tsx src/cli/transit.ts nearby",
    "tago:test-arrivals": "tsx src/cli/transit.ts arrivals",
    "tago:test-route-stops": "tsx src/cli/transit.ts route-stops",
    "tago:test-vehicles": "tsx src/cli/transit.ts vehicles",
    "bus:import-stops": "tsx src/cli/transit.ts import-stops",
    "bus:sync-route": "tsx src/cli/transit.ts sync-route",
    "bus:sync-area": "tsx src/cli/transit.ts sync-area",
    "bus:stats": "tsx src/cli/transit.ts stats",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chimap/contracts": "workspace:*",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.3",
    "lru-cache": "^11.2.1",
    "p-limit": "^7.1.1",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "pino": "^9.9.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
