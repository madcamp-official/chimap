{
  "name": "chimap",
  "version": "0.1.0",
  "private": true,
  "description": "목적지는 그대로, 가는 길은 더 건강하게.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "benchmark:mock": "pnpm --filter @chimap/api exec tsx ../../scripts/benchmark-mock.ts",
    "build": "pnpm --filter @chimap/contracts build && pnpm --filter @chimap/api build && pnpm --filter @chimap/web build",
    "dev": "pnpm --filter @chimap/contracts build && pnpm --parallel --filter @chimap/api --filter @chimap/web dev",
    "format:check": "pnpm -r format:check",
    "tago:health": "pnpm --filter @chimap/api tago:health",
    "tago:test-nearby": "pnpm --filter @chimap/api tago:test-nearby",
    "tago:test-arrivals": "pnpm --filter @chimap/api tago:test-arrivals",
    "tago:test-route-stops": "pnpm --filter @chimap/api tago:test-route-stops",
    "tago:test-vehicles": "pnpm --filter @chimap/api tago:test-vehicles",
    "bus:import-stops": "pnpm --filter @chimap/api bus:import-stops",
    "bus:sync-route": "pnpm --filter @chimap/api bus:sync-route",
    "bus:stats": "pnpm --filter @chimap/api bus:stats",
    "test": "pnpm --filter @chimap/contracts build && pnpm -r --if-present test",
    "test:coverage": "pnpm --filter @chimap/contracts build && pnpm -r --if-present test:coverage",
    "test:e2e": "pnpm --filter @chimap/web test:e2e",
    "typecheck": "pnpm --filter @chimap/contracts build && pnpm -r --if-present typecheck"
  }
}
