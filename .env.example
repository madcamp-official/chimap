# CHIMap의 유일한 환경변수 템플릿입니다.
# 로컬에서는 이 파일을 .env로 복사하고 실제 비밀값을 입력합니다.
# 비밀값은 커밋하지 않습니다. VITE_/EXPO_PUBLIC_ 값과 native SDK Client ID/App
# Key는 client binary에 포함되는 공개 식별자이며 server Client Secret과 구분합니다.

NODE_ENV=development

# PostgreSQL 18 + PostGIS
DATABASE_URL=postgresql://chimap:change-me@postgres:5432/chimap
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_SSL_MODE=disable

POSTGRES_DB=chimap
POSTGRES_USER=chimap
POSTGRES_PASSWORD=

# Kakao Local, 경로, 로그인 REST API 키 (서버 전용)
KAKAO_REST_API_KEY=

# 카카오 로그인. Kakao Developers에서 카카오 로그인과 Client Secret을
# 활성화하고 아래 Redirect URI를 정확히 등록합니다.
# 개발: http://localhost:8080/api/v1/auth/kakao/callback
# 운영: https://chimap.madcamp-kaist.org/api/v1/auth/kakao/callback
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=
# openssl rand -base64 48 등으로 생성한 32자 이상의 무작위 값
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_DAYS=30

# Mobile opaque token. 운영 전용 암호화 키는 `openssl rand -base64 32`로 생성합니다.
AUTH_MOBILE_ENABLED=0
AUTH_MOBILE_ACCESS_TTL_MINUTES=15
AUTH_MOBILE_REFRESH_TTL_DAYS=30
AUTH_REFRESH_GRACE_SECONDS=120
AUTH_REFRESH_RETRY_ENCRYPTION_KEY=
# Kakao access_token_info 응답의 숫자 app_id
KAKAO_APP_ID=
# Sign in with Apple identity token의 audience가 되는 iOS Bundle ID
APPLE_CLIENT_ID_IOS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Sign in with Apple .p8 file contents encoded as one base64 string.
APPLE_PRIVATE_KEY_BASE64=
# Kakao iOS/Android SDK Native App Key (앱 binary에 포함되는 식별자)
KAKAO_NATIVE_APP_KEY=

# 독립 배포되는 mobile client의 호환성/운영 설정
MOBILE_MIN_IOS_VERSION=0.1.0
MOBILE_MIN_ANDROID_VERSION=0.1.0
MOBILE_MAINTENANCE_ENABLED=0
MOBILE_MAINTENANCE_MESSAGE=
MOBILE_SUPPORTED_REGIONS=대전
MOBILE_PRIVACY_POLICY_VERSION=2026-07-26
MOBILE_VEHICLE_POLLING_INTERVAL_SECONDS=15
MOBILE_GUEST_ENABLED=1

# 같은 NAVER Maps Application을 쓰면 두 Key ID에는 같은 공개 Client ID를
# 입력합니다. NAVER_MAP_NCP_KEY만 서버 전용 Client Secret입니다.
NAVER_MAP_NCP_KEY_ID=
NAVER_MAP_NCP_KEY=
VITE_NAVER_MAP_NCP_KEY_ID=
# NAVER Maps Native SDK는 Web 및 서로 간에 분리된 Application Client ID를 씁니다.
NAVER_MAP_CLIENT_ID_IOS=
NAVER_MAP_CLIENT_ID_ANDROID=

# Expo Development Build 환경. EAS profile이 APP_ENV를 덮어씁니다.
APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 공공데이터포털 TAGO (서버 전용)
DATA_GO_KR_SERVICE_KEY=
TAGO_BUS_STOP_SERVICE_KEY=
TAGO_BUS_ROUTE_SERVICE_KEY=
TAGO_BUS_ARRIVAL_SERVICE_KEY=
TAGO_BUS_LOCATION_SERVICE_KEY=

TAGO_BASE_URL=https://apis.data.go.kr/1613000
TAGO_RESPONSE_TYPE=json
TAGO_DEFAULT_CITY_CODE=25
BUS_STOPS_DATA_PATH=/data/bus-stops.csv
TAGO_HTTP_TIMEOUT_MS=7000
TAGO_HTTP_RETRY_COUNT=2
TAGO_NEARBY_STOP_CACHE_TTL_SECONDS=300
TAGO_ROUTE_CACHE_TTL_SECONDS=86400
TAGO_ROUTE_STOPS_CACHE_TTL_SECONDS=86400
TAGO_ARRIVAL_CACHE_TTL_SECONDS=20
TAGO_LOCATION_CACHE_TTL_SECONDS=10

# 공개 주변 정류장 API 상한 / 추천 내부 점진 탐색 상한
TRANSIT_MAX_NEARBY_STOP_DISTANCE_METERS=500
TRANSIT_ROUTE_SEARCH_MAX_DISTANCE_METERS=1200
TRANSIT_MAX_TRANSFER_COUNT=1
TRANSIT_WALK_SPEED_KMH=4.5
TRANSIT_BUS_AVERAGE_SPEED_KMH=20
TRANSIT_STOP_DWELL_SECONDS=25

PORT=8080
WEB_ORIGIN=http://localhost:5173
WEB_DIST_PATH=
LOG_LEVEL=info
LIVE_API_TEST=0

# 내부 Prometheus endpoint. Compose에서는 api:9091/metrics로만 접근합니다.
METRICS_ENABLED=0
METRICS_PORT=9091
APP_COMMIT_SHA=
BACKUP_STATUS_PATH=
BACKUP_DIR=/var/backups/chimap
TRANSIT_SYNC_STATUS_PATH=
TRANSIT_SYNC_STATUS_DIR=/var/backups/chimap/transit-sync
TRANSIT_SYNC_AREAS_FILE=/root/chimap/ops/transit-sync-areas.json

# 운영자 장애 알림. URL은 서버의 실제 .env에만 입력합니다.
# slack: Slack Incoming Webhook, discord: Discord Webhook,
# generic: 정규화한 경보 JSON을 받을 HTTPS endpoint
ALERT_NOTIFICATION_PROVIDER=slack
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=5000
ALERT_RELAY_PORT=9080
ALERT_STATUS_URL=https://chimap.madcamp-kaist.org/api/v1/health

# 비워 두면 개발은 http://localhost:8080, 운영은 same-origin /api를 사용합니다.
VITE_API_BASE_URL=
